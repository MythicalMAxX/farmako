# .gitignore for Farmako project (covers both frontend and backend)

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Frontend (React/Node.js)
# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
/coverage

# Production build
/build
/dist
/out

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backend (Go)
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Dependency directories (remove if using Go modules)
/vendor/

# Binary builds
/bin/
/backend/main
/backend/app
/backend/__debug_bin

# Temporary database files
*.db
*.db-journal

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.DS_Store

# OS specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
